# Environment Configuration Template
# Copy to .env and adjust values for your local or production deployment.

# ==========================================
# 1. DATABASE (PostgreSQL 16 with pgvector)
# ==========================================
POSTGRES_USER=radar_admin
POSTGRES_PASSWORD=radar_secret_pass
POSTGRES_DB=student_radar_db
DATABASE_URL=postgresql+asyncpg://radar_admin:radar_secret_pass@localhost:5432/student_radar_db
SYNC_DATABASE_URL=postgresql://radar_admin:radar_secret_pass@localhost:5432/student_radar_db

# ==========================================
# 2. REDIS & CELERY
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# 3. AI & SEARCH APIS
# ==========================================
# Google Gemini API key (live AI extraction, embeddings, PR playbooks,
# and Search Grounding for real event discovery)
GEMINI_API_KEY=

# External grounding providers. Tavily is always tried first; Exa is used only
# when Tavily is absent, unconfigured, or returns no results. Without a key,
# responses contain real search URLs marked is_live:false.
TAVILY_API_KEY=
EXA_API_KEY=
ENABLE_EXTERNAL_INTELLIGENCE=true
EXTERNAL_SIGNAL_TIMEOUT_SECONDS=5.0
EXTERNAL_SIGNAL_MAX_PER_SOURCE=3
SIGNAL_CACHE_TTL_MINUTES=180

# Intent + recency Radar pipeline
# Gemini fills the query slots; these templates and domain locks stay fixed.
RADAR_HACKATHON_DOMAINS='["devfolio.co","unstop.com","dorahacks.io","devpost.com","mlh.io","hackerearth.com"]'
RADAR_BUILDER_DOMAINS='["reddit.com","x.com","news.ycombinator.com","indiehackers.com"]'
RADAR_TAVILY_SEARCH_DEPTH=advanced
RADAR_TAVILY_NEWS_TIME_RANGE=week
RADAR_TAVILY_TIME_RANGE=month
RADAR_TAVILY_MAX_RESULTS=10
RADAR_TAVILY_FILTER_BY_PUBLISHED_DATE=true
RADAR_TAVILY_INCLUDE_PUBLISHED_DATE=true
RADAR_RERANK_THRESHOLD=65
RADAR_SCAN_LANGUAGE=en
RADAR_ON_DEMAND_MAX_INTENTS=3

# ==========================================
# 4. SECURITY & AUTH
# ==========================================
APP_ENV=development
JWT_SECRET=super_secret_jwt_key_for_development_purposes_only_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days
GUEST_SESSION_EXPIRE_HOURS=24
DEFAULT_PERSONA=tech_builder
DEFAULT_CITY=Pune

# Google OAuth Credentials (Optional for local testing; simulated flow available)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ==========================================
# 5. VISIBILITY CREDITS ECONOMY & SCHEDULING
# ==========================================
SIGNUP_CREDITS=30
REFERRAL_SIGNUP_CREDITS=15
PEER_REVIEW_CREDITS=10
BOOST_COST_CREDITS=20
BOOST_DURATION_HOURS=48
URGENT_WINDOW_HOURS=72
INVITE_DAILY_LIMIT=10
MATCHMAKING_LIMIT=5

# Celery Beat schedule (all times IST)
CRAWL_HOUR_IST=5
CRAWL_MINUTE_IST=30
SIGNAL_REFRESH_HOUR_IST=6
SIGNAL_REFRESH_MINUTE_IST=0
DAILY_BRIEFING_HOUR_IST=7
WEEKLY_BRIEFING_DAY=sunday
WEEKLY_BRIEFING_HOUR_IST=18

# Queue briefing/invite email tasks when a broker and ESP are configured.
ENABLE_CELERY_DISPATCH=false

# ==========================================
# 6. STORAGE & CDN (Cloudflare R2 / S3)
# ==========================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=student-radar-assets
R2_PUBLIC_DOMAIN=https://assets.studentradar.dev

# ==========================================
# 7. APPLICATION & FRONTEND
# ==========================================
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

