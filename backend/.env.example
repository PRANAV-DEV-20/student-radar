# Copy to backend/.env (or the repository .env) and fill real values.
# Never commit real keys.

APP_ENV=development

# Database / Redis
DATABASE_URL=postgresql+asyncpg://radar_admin:radar_secret_pass@localhost:5432/student_radar_db
SYNC_DATABASE_URL=postgresql://radar_admin:radar_secret_pass@localhost:5432/student_radar_db
REDIS_URL=redis://localhost:6379/0

# Dossier v2 / AI provider
# Required. The old deterministic dossier generator is retired: without this
# key the API returns 503 AI_PROVIDER_NOT_CONFIGURED and produces no fake text.
GEMINI_API_KEY=your_real_gemini_api_key_here
# Live-probed defaults (2026-11-24). Do not change without probing the key.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_CRITIC_MODEL=gemini-3-flash-preview
GEMINI_SMALL_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=["gemini-3.5-flash-lite","gemini-3.1-flash-lite","gemini-flash-lite-latest","gemini-3-flash-preview"]
# Dossier v2 uses only live-probed ids. 3-flash-preview stays excluded (429);
# 3.1-flash-lite recovered from an earlier 503 and is the third Gemini option.
DOSSIER_V2_MODEL_CHAIN=["gemini-3.5-flash-lite","gemini-flash-lite-latest","gemini-3.1-flash-lite"]
DOSSIER_V2_CRITIC_MODEL_CHAIN=["gemini-flash-lite-latest","gemini-3.1-flash-lite","gemini-3.5-flash-lite"]
# Free-tier keys cannot serve 18 independent section calls in one burst.
# Sections are written three at a time and the whole run has a hard deadline
# so a provider outage ends in an honest terminal state instead of hanging.
DOSSIER_V2_SECTION_BATCH_SIZE=3
DOSSIER_V2_RUN_TIMEOUT_SECONDS=220
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Second provider fallback (live-probed 2026-11-24). The dossier client falls
# back to this model when every Gemini model is quota-limited or unavailable.
# Pricing is read from the public Groq model list (0.075 input / 0.30 output
# USD per 1M tokens) and recorded in ai_runs like every other call.
GROQ_API_KEY=your_real_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODEL_FALLBACKS=["openai/gpt-oss-20b","allam-2-7b"]
# Dossier v2 bypasses the rate-limited qwen planner and uses this id directly.
DOSSIER_V2_GROQ_MODEL=openai/gpt-oss-20b

# Web retrieval (Tavily is used for web search; Exa is optional and currently unused)
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=

# Optional: raises GitHub API rate limit for repo ingestion/related work
GITHUB_TOKEN=
